#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

/* Screen-space reflections for the wet streets.
 *
 * For each pixel the scene pass marked reflective (city.frag: outRefl), march
 * the mirror ray through the depth buffer: steps that grow with distance,
 * then a binary search to the surface once the ray passes behind it. The hit
 * takes the HDR scene's colour there. Confidence fades toward the screen edge,
 * at the end of the march and for rays turning back toward the camera, so the
 * sky reflection the scene pass already added takes over smoothly where the
 * screen holds nothing to reflect. ssr_apply.frag blurs and blends the result.
 *
 * Output: rgb = reflected colour, a = confidence. */
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 3) uniform sampler2D hdrTex;
layout(set = 0, binding = 4) uniform sampler2D sceneDepth;
layout(set = 0, binding = 5) uniform sampler2D reflTex;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D ssrOut;

const int STEPS = 64;
const int REFINE = 6;

ivec2 gSize;

float depthAt(vec2 uv) { return forwardDist(texelFetch(sceneDepth, clamp(ivec2(uv * vec2(gSize)), ivec2(0), gSize - 1), 0).r); }

// Screen uv and forward distance of camera-relative point q (w <= 0: behind the camera).
vec3 project(vec3 q) {
    vec4 c = frame.viewProj * vec4(q, 1.0);
    return c.w > 1e-3 ? vec3(c.xy / c.w * 0.5 + 0.5, c.w) : vec3(-1.0);
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    gSize = imageSize(ssrOut);
    if (any(greaterThanEqual(px, gSize))) return;
    vec4 g = texelFetch(reflTex, px, 0);
    if (g.a <= 1e-3) { imageStore(ssrOut, px, vec4(0.0)); return; }

    vec2 uv = (vec2(px) + 0.5) / vec2(gSize);
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 dir = normalize(frame.rayBasis[2].xyz + ndc.x * frame.rayBasis[0].xyz - ndc.y * frame.rayBasis[1].xyz);
    float fwd = forwardDist(texelFetch(sceneDepth, px, 0).r);
    vec3 n = vec3(g.x, sqrt(max(1.0 - g.x * g.x - g.y * g.y, 0.0)), g.y);
    vec3 P = dir * (fwd / max(dot(dir, frame.camFwd.xyz), 1e-4)) + n * 0.02;
    vec3 R = reflect(dir, n);

    float t = 0.0, tPrev = 0.0, dt = 0.06 + 0.008 * fwd;
    vec3 hit = vec3(-1.0);
    int hitStep = 0;
    for (int i = 0; i < STEPS; ++i) {
        tPrev = t;
        t += dt;
        dt *= 1.07;
        vec3 s = project(P + R * t);
        if (s.z < 0.0 || any(lessThan(s.xy, vec2(0.0))) || any(greaterThan(s.xy, vec2(1.0)))) break;
        float behind = s.z - depthAt(s.xy);
        if (behind > 0.02 && behind < max(0.5, dt * 2.5)) {
            // refine between the last step in front and this one
            float a = tPrev, b = t;
            for (int k = 0; k < REFINE; ++k) {
                float m = 0.5 * (a + b);
                vec3 sm = project(P + R * m);
                if (sm.z - depthAt(sm.xy) > 0.0) b = m; else a = m;
            }
            hit = project(P + R * b);
            hitStep = i;
            break;
        }
    }
    if (hit.z < 0.0) { imageStore(ssrOut, px, vec4(0.0)); return; }

    vec2 e = min(hit.xy, 1.0 - hit.xy);
    float conf = smoothstep(0.0, 0.07, e.x) * smoothstep(0.0, 0.07, e.y)
               * (1.0 - smoothstep(0.75, 1.0, float(hitStep) / float(STEPS)))   // the march's last steps
               * smoothstep(-0.3, 0.1, dot(R, frame.camFwd.xyz));
    vec3 col = textureLod(hdrTex, hit.xy, 0.0).rgb;
    imageStore(ssrOut, px, vec4(min(col, vec3(64.0)), conf));
}
