#version 460
#extension GL_GOOGLE_include_directive : require
#include "interior/bake_scene.glsl"

/* The ground truth (tools/interior_bake: gpu_truth): what a camera at P_cam
 * sees through the module's glass, traced in the full scene. One invocation
 * per pixel of the evaluation grid, a grid of points on the glass plane: the
 * ray runs from the camera through the point, through partition glass, to
 * the first opaque surface, or out of the far glass.
 *
 * Out: radiance, and in a the depth of the hit (-1: out of the far glass), averaged over the pixel. */
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, set = 0, binding = 6) writeonly buffer OutColor { vec4 outColor[]; };

vec4 truthRay(vec3 o) {
    vec3 d = normalize(o - P_cam.xyz);
    float tEnd = volumeExit(o, d);
    float glassT = 1.0;
    vec3 glassR = vec3(0.0), col = P_outside.rgb;
    float z = -1.0, t = 0.0;
    for (int it = 0; it < 160; ++it) {
        Hit h;
        if (!traceNext(o, d, t, tEnd, h)) break;
        t = h.t + max(1e-4, h.t * 1e-5);
        uint flags = insts[h.inst].flags;
        if ((flags & BF_GLASS) != 0u) {
            if (h.front) {
                float R = glassReflect(abs(dot(h.n, d)));
                glassR += glassT * R * P_glass.z;
                glassT *= (1.0 - R) * P_glass.y;
            }
            continue;
        }
        uint m = insts[h.inst].material;
        if ((flags & BF_OPEN) != 0u || h.front) col = shadeSurface(o + d * h.t, h.front ? h.n : -h.n, m);
        else col = mats[m].albedo.rgb * P_volume.z;   // starts in a solid: never through the opening
        z = h.t * d.z;
        break;
    }
    return vec4(glassR + glassT * col, z);
}

/* P_glass.w x P_glass.w rays a pixel, on a regular grid, averaged. */
void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= P_evalDim.x || px.y >= P_evalDim.y) return;
    int n = max(int(P_glass.w), 1);
    vec4 sum = vec4(0.0);
    for (int j = 0; j < n; ++j)
        for (int i = 0; i < n; ++i)
            sum += truthRay(vec3(P_eval.xy + (vec2(px) + (vec2(i, j) + 0.5) / float(n)) / P_eval.zw, 0.0));
    outColor[px.y * P_evalDim.x + px.x] = sum / float(n * n);
}
