#version 460
#extension GL_GOOGLE_include_directive : require
#include "interior/bake_scene.glsl"
#include "interior/pathtrace.glsl"
#define IMP_VIEWS_ONLY
#include "city/impostor.glsl"

/* The layered capture (tools/interior_bake: gpu_capture). One invocation per
 * texel of one view (z): its ray, from the glass plane along the view's
 * direction, walks every surface to where it leaves the building and builds
 * the intervals it spends inside solids, nearest first. Touching or
 * overlapping solids make one interval. An open mesh (leaves) is a shell of
 * thickness P_volume.w. Partition glass is not an interval: what lies behind
 * it is recorded as seen through it, with its reflection added.
 *
 * Out: slots 0..3, the four nearest intervals, and slot 4, the last, each
 * with its entry's radiance, albedo and normal; and the count of intervals.
 * The lab and the bake choose which K of them an impostor keeps.
 *
 * The light is IM1's direct light (P_trace2.x = 0: the lab), or path traced
 * (1: a bake). A path-traced capture runs in passes, each adding its share of
 * the samples (P_trace) to the radiance of one view (P_trace4.x), and traces
 * only the first P_trace2.y slots. A pane in front of a slot adds what it
 * reflects, traced too. */
layout(local_size_x = 8, local_size_y = 8) in;

struct Layer { vec4 lit; vec2 depth; uint albedo; uint normal; };
layout(std430, set = 0, binding = 6) buffer OutLayers { Layer outLayers[]; };
layout(std430, set = 0, binding = 7) writeonly buffer OutCounts { uint outCounts[]; };

#define NEAR_SLOTS 4
#define SLOTS 5

ImpViews paramViews() { ImpViews v; v.n = P_views.xy; v.kind = P_views.z; v.range = P_viewRange; return v; }

bool pathTraced() { return P_trace2.x != 0; }

// This pass's mean of the radiance leaving surface point p (normal n, material m) towards -d, path
// traced; a, the luminance of it that came by a specular first bounce.
vec4 tracedSurface(vec3 p, Surf s, vec3 d, uint m, bool front, uint texel, uint slot) {
    vec4 sum = vec4(0.0);
    for (int i = 0; i < P_trace.y; ++i) {
        uint rng = ptSeed(texel, slot, uint(P_trace.x + i));
        vec3 c = ptRadiance(p, s, -d, rng);
        sum += vec4(c, gPtSpec);
    }
    vec3 Le = front ? ptVisibleEmission(m, s.look) : vec3(0.0);
    return vec4(Le * (float(P_trace.y) / float(P_trace.z)), 0.0) + sum / float(P_trace.z);
}

// This pass's share of what a pane at q (normal n) reflects of the ray along d.
vec3 tracedReflection(vec3 q, vec3 n, vec3 d, uint texel, uint pane) {
    vec3 sum = vec3(0.0), r = reflect(d, n);
    for (int i = 0; i < P_trace.y; ++i) {
        uint rng = ptSeed(texel, 16u + pane, uint(P_trace.x + i));
        sum += ptTrace(q + r * 1e-4, r, rng);
    }
    return sum / float(P_trace.z);
}

Layer shadeLayer(vec3 o, vec3 d, Hit h, bool startedInside, float glassT, vec3 glassR, float e, uint texel, int slot) {
    uint m = insts[h.inst].material;
    vec3 n = h.front ? h.n : -h.n;   // the side the ray sees
    vec3 p = o + d * h.t;
    Surf s = surfAt(h, p, d, 1.0 / P_grid.z);   // a texel's width: its albedo and normal stand for the whole texel
    vec4 lit;
    if (!pathTraced()) lit = vec4(startedInside ? mats[m].albedo.rgb * P_volume.z : shadeSurface(o + d * h.t, n, m), 0.0);
    else if (startedInside || slot >= P_trace2.y) lit = vec4(0.0);   // a slab seen from inside it: the facade covers it
    else lit = tracedSurface(p, s, d, m, h.front, texel, uint(slot));
    Layer l;
    // a pane's reflection is specular, whatever it reflects
    l.lit = vec4(glassR + glassT * lit.rgb, ptLum(glassR) + glassT * lit.a);
    l.depth = vec2(e, 1.0);
    l.albedo = packAlbedo(s.albedo);
    l.normal = packNormal(s.ns);
    return l;
}

/* A BF_LEAKY mesh, as the ray entered it: how many of its fronts it has yet to leave by a back,
 * and where it leaves the mesh's bounds, past which it can't still be in that mesh. */
struct Leak { uint inst; int count; float tExit; };
#define MAX_LEAKS 8
Leak gLeaks[MAX_LEAKS];
int gNLeaks = 0;

float leakExit(Hit h, vec3 o, vec3 d) {
    vec3 ro = h.w2o * vec4(o, 1.0), rd = h.w2o * vec4(d, 0.0) + vec3(1e-9);
    Inst in_ = insts[h.inst];
    vec3 a = (in_.bmin.xyz - ro) / rd, b = (in_.bmax.xyz - ro) / rd, far_ = max(a, b);
    return min(far_.x, min(far_.y, far_.z));
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    int view = int(gl_GlobalInvocationID.z) + P_trace4.x;
    if (px.x >= P_gridDim.x || px.y >= P_gridDim.y) return;
    uint texel = uint((view * P_gridDim.y + px.y) * P_gridDim.x + px.x);
    vec3 d = impViewDirIndex(paramViews(), view);
    vec3 o = vec3(P_grid.xy + (vec2(px) + 0.5) / P_grid.z, 0.0);
    float tEnd = volumeExit(o, d), D = P_module.z, thin = P_volume.w;

    Layer L[SLOTS];
    for (int i = 0; i < SLOTS; ++i) { L[i].lit = vec4(0.0); L[i].depth = vec2(1.0); L[i].albedo = 0u; L[i].normal = 0u; }
    int n = 0;                 // intervals so far
    int inside = 0;            // closed solids the ray is in
    float lastExit = -1.0;     // the latest interval's exit, metres
    float glassT = 1.0;
    vec3 glassR = vec3(0.0);
    Hit lastHit;               // the latest interval's entry, shaded at the end if past the near slots
    lastHit.t = 0.0; lastHit.n = vec3(0.0); lastHit.inst = 0u; lastHit.front = true;
    bool lastInside = false;
    float lastGT = 1.0, lastEntry = 0.0;
    vec3 lastGR = vec3(0.0);

    /* A ray that starts in a slab (off the opening) is inside it from depth 0 until it enters the room. */
    float tRoom = roomEnter(o, d);
    if (tRoom > 0.0) {
        Hit h0;
        if (!traceNext(o, d, 0.0, 1e4, h0)) h0.inst = 0u;   // the slab's material, near enough
        h0.t = 0.0; h0.front = false; h0.n = -d;
        L[0] = shadeLayer(o, d, h0, true, 1.0, vec3(0.0), 0.0, texel, 0);
        lastHit = h0; lastInside = true; lastEntry = 0.0;
        n = 1;
        inside = 1;
        if (tRoom >= tEnd) lastExit = tEnd * d.z;
    }

    float t = max(min(tRoom, tEnd) - 1e-3, 0.0);   // surfaces inside the slab are the slab's
    uint panes = 0u;
    for (int it = 0; it < 160; ++it) {
        Hit h;
        bool more = traceNext(o, d, t, tEnd, h);
        // a mesh whose bounds the ray has left, with what it never closed: it ends there
        float upTo = more ? h.t : 1e30;
        for (int l = gNLeaks - 1; l >= 0; --l) {
            if (gLeaks[l].tExit >= upTo) continue;
            float tx = min(gLeaks[l].tExit, tEnd);
            bool wasIn = inside > 0;
            inside = max(inside - gLeaks[l].count, 0);
            if (wasIn && inside == 0 && n > 0) {
                lastExit = max(lastExit, tx * d.z);
                if (n - 1 < NEAR_SLOTS) L[n - 1].depth.y = min(lastExit / D, 1.0);
            }
            gLeaks[l] = gLeaks[--gNLeaks];
        }
        if (!more) break;
        t = h.t + max(1e-4, h.t * 1e-5);
        uint flags = insts[h.inst].flags;
        if ((flags & BF_GLASS) != 0u) {
            if (inside == 0 && h.front) {
                float R = glassReflect(abs(dot(h.n, d)));
                vec3 seen = pathTraced() ? (n < P_trace2.y ? tracedReflection(o + d * h.t, h.n, d, texel, panes) : vec3(0.0)) : vec3(P_glass.z);
                glassR += glassT * R * seen;
                panes++;
                glassT *= (1.0 - R) * P_glass.y;
            }
            continue;
        }
        float z = h.t * d.z;
        bool begin = false, end = false;
        float e = z, x = z;
        if ((flags & BF_OPEN) != 0u) {
            if (inside == 0) { begin = true; end = true; x = z + thin; }
        } else if ((flags & BF_LEAKY) != 0u) {
            int e = -1;
            for (int l = 0; l < gNLeaks; ++l) if (gLeaks[l].inst == h.inst) e = l;
            if (h.front) {
                if (e < 0 && gNLeaks < MAX_LEAKS) { e = gNLeaks++; gLeaks[e].inst = h.inst; gLeaks[e].count = 0; gLeaks[e].tExit = leakExit(h, o, d) + 1e-3; }
                if (e >= 0) { gLeaks[e].count++; if (inside++ == 0) begin = true; }
                else if (inside == 0) { begin = true; end = true; x = z + thin; }
            } else if (e >= 0 && gLeaks[e].count > 0) {
                gLeaks[e].count--;
                if (--inside == 0) end = true;
            } else if (inside == 0) {   // the back of a sheet with no front: seen as a shell
                begin = true; end = true; x = z + thin;
            }
        } else if (h.front) {
            if (inside++ == 0) begin = true;
        } else if (inside > 0) {
            if (--inside == 0) end = true;
        }
        if (begin && !(n > 0 && e <= lastExit + 1e-3)) {   // else touching or overlapping the previous interval: one solid
            if (n < NEAR_SLOTS) L[n] = shadeLayer(o, d, h, false, glassT, glassR, e / D, texel, n);
            lastHit = h; lastInside = false; lastGT = glassT; lastGR = glassR; lastEntry = e;
            n++;
        }
        if (end) {
            lastExit = max(lastExit, x);
            if (n - 1 < NEAR_SLOTS) L[n - 1].depth.y = min(lastExit / D, 1.0);
        }
    }
    if (inside > 0 && n > 0) {   // still in a solid where the ray leaves the building
        lastExit = max(lastExit, tEnd * d.z);
        if (n - 1 < NEAR_SLOTS) L[n - 1].depth.y = min(lastExit / D, 1.0);
    }
    if (n > NEAR_SLOTS) {
        L[NEAR_SLOTS] = shadeLayer(o, d, lastHit, lastInside, lastGT, lastGR, lastEntry / D, texel, NEAR_SLOTS);
        L[NEAR_SLOTS].depth.y = min(lastExit / D, 1.0);
    } else if (n > 0) {
        L[NEAR_SLOTS] = L[n - 1];
    }

    for (int i = 0; i < SLOTS; ++i) {   // a later pass adds its samples to the earlier passes'
        uint at = texel * uint(SLOTS) + uint(i);
        if (pathTraced() && P_trace.x > 0) L[i].lit += outLayers[at].lit;
        outLayers[at] = L[i];
    }
    outCounts[texel] = uint(n);
}
