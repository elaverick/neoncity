#version 450
// 3x3 tent upsample of the smaller mip, accumulated into the larger one.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba16f) uniform image2D dst;
layout(push_constant) uniform Push { float threshold, knee, radius; int prefilter; } pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dst);
    if (p.x >= size.x || p.y >= size.y) return;
    vec2 t = pc.radius / vec2(textureSize(src, 0));
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    vec3 s = texture(src, uv).rgb * 4.0;
    s += (texture(src, uv + vec2(-t.x, 0)).rgb + texture(src, uv + vec2(t.x, 0)).rgb +
          texture(src, uv + vec2(0, -t.y)).rgb + texture(src, uv + vec2(0, t.y)).rgb) * 2.0;
    s += texture(src, uv + vec2(-t.x, -t.y)).rgb + texture(src, uv + vec2(t.x, -t.y)).rgb +
         texture(src, uv + vec2(-t.x, t.y)).rgb + texture(src, uv + vec2(t.x, t.y)).rgb;
    vec3 cur = imageLoad(dst, p).rgb;
    imageStore(dst, p, vec4(cur + s / 16.0, 1.0));
}
