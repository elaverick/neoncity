#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "adverts.glsl"   // what the screens show (binding 9)

/* Rain clouds: a low nimbostratus deck with torn scud drifting beneath it,
 * ray marched at half resolution. The deck hangs over the cities and a
 * border round them (cloudCover, src/core/clouds.h) and breaks up beyond, so
 * each ray is marched only where it passes over a city's cloud.
 *
 * Each half-res pixel marches its view ray through the cloud layer, stopping
 * at the nearest scene depth in its 2x2 block, so the deck swallows the tops
 * of the tallest towers. At night the deck is lit from below by the city:
 * every step looks down through the cloud toward the street (a short light
 * march) and adds a few multiple-scattering octaves, so the underside glows
 * sodium-orange while the body above stays dark and heavy; past the city's
 * edge that glow dies away (cityLight), and the moon silvers the cloud from
 * above. Neon signs and
 * video screens high on the towers (sky lights, src/core/common.h) also light the
 * cloud around them in their own colour, flickering and changing with them,
 * found through a coarse grid around the camera. Each step is also
 * fogged by its own distance, so the deck dissolves into the haze at range.
 *
 * Output: rgb = in-scattered light, a = transmittance, and the forward
 * distance the march stopped at (for the depth-aware upsample in
 * cloud_composite.frag). */
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 3) uniform sampler3D cloudNoise;   // cloud_noise.comp
layout(set = 0, binding = 4) uniform sampler2D sceneDepth;
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D cloudOut;
layout(set = 0, binding = 6, r32f) uniform writeonly image2D cloudDist;

struct SkyLight { vec3 pos; float power; vec2 n; uint seed; uint kind; };   // src/core/common.h
layout(std430, set = 0, binding = 7) readonly buffer SkyLights {
    vec2 skyOrigin;                    // camera-relative corner of cell (0, 0)
    float skyCell;
    uint skyCount;
    uint skyCells[SKY_GRID * SKY_GRID];   // first index << 8 | count
    uint skyIndex[SKY_MAX_INDEX];
    SkyLight skyLight[SKY_MAX_LIGHTS];
    uint airCount;
    SkyLight airLight[AIR_MAX_LIGHTS];   // lamps, shopfronts and signs near the camera
};
// Rain mist: light the rain-filled air scatters toward the eye, near the street.
layout(set = 0, binding = 8, rgba16f) uniform writeonly image2D mistOut;

const float CLOUD_BASE = 200.0;            // mean height of the deck's underside
const float CLOUD_TOP = CLOUD_HIGH;
const float SCUD_LO = CLOUD_LOW;           // torn scud drifts between here and the deck
const float SHAPE_SCALE = 1.0 / 900.0;     // the noise volume repeats every 900 m for the deck's masses...
const float DETAIL_SCALE = 1.0 / 170.0;    // ...and every 170 m for the eroded edges
const float SCUD_SCALE = 1.0 / 480.0;
const float SIGMA = 0.012;                 // extinction per metre at density 1
const vec3 WIND = vec3(1.5, 0.0, 0.55);    // deck drift, m/s; the scud below runs faster
const float GLOW = 1.3;                    // city light reaching the cloud base
// Past VIEW_DISTANCE the deck is marched every FAR_STEP metres without the
// eroded detail, out to MID_REACH across the ground. At the deck's height
// the city's haze has taken about 97% of its light by there; under the
// countryside's clearer air it is marched on to CLOUD_REACH (clouds.h) in
// DISTANT_STEPS, so a city's clouds stand on the skyline.
const float FAR_STEP = 80.0;
const float MID_REACH = 9000.0;
const int   DISTANT_STEPS = 40;

float gTime;

float remap(float x, float a, float b, float c, float d) { return c + (x - a) * (d - c) / (b - a); }

// Per-column cloud state: cover (mostly overcast, with slow-moving thinner
// patches and breaks, and breaking up as the cities' cloud thins out:
// field, cloudCover) and the height of the deck's underside, which sags
// lower where the deck is heaviest and undulates on its own.
struct Column { float cov; float base; float field; };
Column column(vec2 xz, float field) {
    Column c;
    c.field = field;
    c.cov = mix(0.25, 0.85, smoothstep(0.2, 0.8, fbm(xz / 1800.0, 0xC10Du))) * field;
    c.base = CLOUD_BASE + 80.0 * (fbm(xz / 650.0, 0xC111u) - 0.5) - 50.0 * (c.cov - 0.55);
    return c;
}

// Light thrown up by the city: sodium-orange, brighter over dense districts,
// tinted by the neon in places.
vec3 cityGlow(vec2 xz) {
    float a = fbm(xz / 1400.0, 0xC10Eu);
    vec3 c = vec3(1.0, 0.50, 0.26) * mix(0.5, 1.4, a);
    return mix(c, vec3(0.95, 0.38, 0.80), smoothstep(0.62, 0.9, vnoise(xz / 2100.0, 0xC10Fu)) * 0.4);
}

float erodeBy(vec3 q) {
    vec4 dn = textureLod(cloudNoise, q * DETAIL_SCALE, 0.0);
    return dn.g * 0.625 + dn.b * 0.25 + dn.a * 0.125;
}

// The deck: a thick sheet of billowing masses over an undulating underside.
float deck(vec3 p, Column c, bool detail) {
    float h = (p.y - c.base) / (CLOUD_TOP - c.base);
    if (h < 0.0 || h > 1.0) return 0.0;
    vec4 n = textureLod(cloudNoise, p * SHAPE_SCALE, 0.0);
    float wfbm = n.g * 0.625 + n.b * 0.25 + n.a * 0.125;
    float shape = remap(n.r, wfbm - 1.0, 1.0, 0.0, 1.0);
    float prof = smoothstep(0.0, 0.12, h) * (1.0 - smoothstep(0.5, 1.0, h));
    float d = clamp(remap(shape * prof, 1.0 - c.cov, 1.0, 0.0, 1.0), 0.0, 1.0);
    if (detail && d > 0.0) {
        float df = erodeBy(p + vec3(0.0, gTime * 0.12, 0.0));
        // ragged along the underside, rounder billows higher up
        float e = mix(1.0 - df, df, clamp(h * 3.0, 0.0, 1.0));
        d = clamp(remap(d, e * 0.45, 1.0, 0.0, 1.0), 0.0, 1.0);
    }
    return d;
}

// Scud: torn fragments hanging below the deck, more of them under heavy cloud.
float scud(vec3 p, Column c, bool detail) {
    float top = c.base + 20.0;
    if (p.y < SCUD_LO || p.y > top) return 0.0;
    float hs = (p.y - SCUD_LO) / (top - SCUD_LO);
    vec3 q = p + WIND * gTime * 0.5;
    vec4 n = textureLod(cloudNoise, q * SCUD_SCALE, 0.0);
    float wfbm = n.g * 0.625 + n.b * 0.25 + n.a * 0.125;
    float shape = remap(n.r, wfbm - 1.0, 1.0, 0.0, 1.0) * smoothstep(0.0, 0.6, hs) * smoothstep(1.0, 0.85, hs);
    float d = clamp(remap(shape, 0.66 - 0.25 * c.cov, 1.0, 0.0, 1.0), 0.0, 1.0);
    if (detail && d > 0.0) d = clamp(remap(d, (1.0 - erodeBy(q * 1.7)) * 0.6, 1.0, 0.0, 1.0), 0.0, 1.0);
    return d * c.field;
}

// Density at world point p (deck drift already applied).
float density(vec3 p, Column c, bool detail) { return max(deck(p, c, detail), scud(p, c, detail)); }

// Light scattered toward the eye at p: city glow from below through the cloud
// between p and the street, plus the moon and a trace of night sky from
// above through the deck towards the moon, brightest looking towards it
// (mu: the cosine between the ray and the moon).
vec3 lightAt(vec3 p, Column c, vec3 glow, float mu) {
    float below = max(p.y - SCUD_LO, 1.0);
    float od = 0.0;
    for (int i = 0; i < 4; ++i) od += density(p - vec3(0.0, below * (float(i) + 0.5) * 0.25, 0.0), c, false);
    od *= below * 0.25 * SIGMA;
    // multiple scattering: light diffuses deep into the deck rather than dying out
    float ms = exp(-od) + 0.3 * exp(-od * 0.25) + 0.1 * exp(-od * 0.06);
    float above = max(CLOUD_TOP - p.y, 1.0) / MOON_DIR.y;
    float odUp = deck(p + MOON_DIR * (above * 0.35), c, false) * above * SIGMA * 0.5;
    // the city's light spreads as it rises: the lowest scud and bulges catch the most
    float fall = exp(-(p.y - SCUD_LO) / 80.0);
    vec3 moon = MOON_LIGHT * (0.175 + 0.5 * pow(max(mu, 0.0), 8.0)) * (exp(-odUp) + 0.15 * exp(-odUp * 0.25));
    return glow * GLOW * ms * fall + vec3(0.008, 0.010, 0.018) * exp(-odUp) + moon;
}

// What a sky light is showing now: a neon sign's colour through its flicker,
// or the average of a video screen's current advert colours (city.frag): an
// authored advert's mean colour at its brightness, or a procedural scene's two.
vec3 skyLightColor(SkyLight L) {
    if ((L.kind >> 8u & 255u) == AIR_FLAME) return fireColor(0.6) * flameGout(L.seed, gTime).power;   // a flare lighting the cloud base
    if ((L.kind & SKY_KIND_SCREEN) != 0u) {
        uint h = screenAdvert(L.seed, gTime);
        int a = advertPick(h, float((L.kind >> 16u) & 255u) / float(max(L.kind >> 24u, 1u)));
        if (a >= 0 && advertPhase(L.seed, gTime) >= ADVERT_STATIC) return advert[a].mean.rgb * advert[a].play.y;
        return mix(neonColor(h >> 4), neonColor(h >> 8), 0.5);
    }
    return neonColor(L.kind & 7u) * neonFlicker(L.seed, (L.kind >> 3) & 3u, gTime);
}

// A flare's light (AIR_FLAME: push_flame in src/city/mesh_emit.c) stands where its
// fire is: from the nozzle it rises with the burning column (n.x carries the
// gout's reach), and airColor dims it with the gout.
SkyLight flameAt(SkyLight L) {
    if ((L.kind >> 8u & 255u) != AIR_FLAME) return L;
    Gout g = flameGout(L.seed, gTime);
    L.pos.y += 0.4 * (g.head + g.tail) * L.n.x;
    L.n = vec2(0.0);
    return L;
}

// Light from nearby signs scattered at camera-relative point q: inverse-square,
// softened by the sign's size, dimmed through the cloud it crosses, and
// strongest in front of the sign.
vec3 signLight(vec3 q) {
    vec2 g = (q.xz - skyOrigin) / skyCell;
    if (any(lessThan(g, vec2(0.0))) || any(greaterThanEqual(g, vec2(float(SKY_GRID))))) return vec3(0.0);
    uint cell = skyCells[int(g.y) * SKY_GRID + int(g.x)];
    uint first = cell >> 8u, n = cell & 255u;
    vec3 sum = vec3(0.0);
    for (uint i = 0u; i < n; ++i) {
        SkyLight L = flameAt(skyLight[skyIndex[first + i]]);
        vec3 d = q - L.pos;
        float r2 = dot(d, d), reach = skyLightRange(L.power);
        if (r2 >= reach * reach) continue;
        float r = sqrt(r2);
        float front = 0.25 + 0.75 * clamp(0.5 + 0.5 * dot(d.xz, L.n) / max(r, 1.0), 0.0, 1.0);
        float att = L.power * SKY_GAIN / (r2 + 0.5 * L.power + 25.0) * exp(-r * SIGMA * 0.35) * (1.0 - smoothstep(0.6 * reach, reach, r));
        sum += skyLightColor(L) * att * front;
    }
    return sum;
}

/* Rain mist. Falling rain fills the air with droplets that scatter the
 * light of every lamp, shopfront and sign: halos round the lamps, glowing
 * cones under them and coloured haze in front of the neon. Each light's
 * in-scattering along the view ray, out to the scene, has a closed form
 * (the "airlight" integral of an inverse-square source):
 *     integral over [0, T] of dt / (h^2 + (t - t0)^2) = (atan((T - t0)/h) + atan(t0/h)) / h
 * where t0 is the ray's closest approach to the light and h its distance
 * there. Shaped by a forward-scattering halo, the lamps' downward cones and
 * the signs' facing. No shadows: lights round a corner glow faintly through. */
const float MIST = 0.0006;   // in-scattering per unit rain intensity

vec3 airColor(SkyLight L) {
    uint cls = L.kind >> 8u & 255u;
    if (cls == AIR_LAMP_SODIUM) return lampColor(0) * lampState(L.seed, gTime);
    if (cls == AIR_LAMP_LED) return lampColor(1) * lampState(L.seed, gTime);
    if (cls == AIR_SHOP) return shopColor(L.seed);
    if (cls == AIR_LOBBY) return LOBBY_SPILL;
    if (cls == AIR_FLAME) return fireColor(0.6) * flameGout(L.seed, gTime).power;
    return skyLightColor(L);
}

vec3 mistLight(vec3 dir, float tEnd, float rain) {
    float T = min(tEnd, AIR_RANGE);
    vec3 sum = vec3(0.0);
    for (uint i = 0u; i < airCount; ++i) {
        SkyLight L = flameAt(airLight[i]);
        float t0 = dot(L.pos, dir);
        vec3 q = dir * clamp(t0, 0.0, T) - L.pos;      // nearest point on the ray, from the light
        uint cls = L.kind >> 8u & 255u;
        // A lamp is a bright head the halo gathers round. A shopfront is a pane
        // metres wide: as a point it glowed as a ball floating in front of the
        // glass, so it is spread over a soft 2.5 m radius with no core; a
        // flare's fire, metres across, over 3 m.
        float hl = length(dir * t0 - L.pos);
        float h = (cls == AIR_SHOP || cls == AIR_LOBBY) ? sqrt(hl * hl + 6.25) : cls == AIR_FLAME ? sqrt(hl * hl + 9.0) : max(hl, 0.25);
        float I = (atan((T - t0) / h) + atan(t0 / h)) / h;
        float lq = max(length(q), 1e-3);
        float shape;
        if (cls == AIR_LAMP_SODIUM || cls == AIR_LAMP_LED)
            shape = mix(0.12, 1.0, smoothstep(0.05, 0.6, -q.y / lq));         // the cone under the lamp head
        else if (cls == AIR_FLAME)
            shape = 1.0;                                                        // fire, all round
        else
            shape = 0.3 + 0.7 * clamp(0.5 + 0.5 * dot(q.xz, L.n) / lq, 0.0, 1.0);   // in front of the sign
        float c = dot(dir, L.pos) / max(length(L.pos), 1e-3);
        float halo = 0.6 + 3.0 * pow(max(c, 0.0), 24.0);                       // rain scatters forward
        sum += airColor(L) * (L.power * I * shape * halo * exp(-h / 60.0));
    }
    return sum * (MIST * rain);
}

// The haze between the eye and cloud at rel, dist away, through air of the
// given density. The band at the chunks' edge (edgeFog) hides their
// handover to the proxies, which clouds take no part in: they take it as
// far as the camera is in a city's air, as everything there does, and out
// in the countryside not at all, so a city's clouds stand out on the skyline.
float cloudFog(vec3 rel, float dist, float density) {
    float haze = hazeAmount(rel, dist, density);
    return mix(haze, edgeFog(haze, dist), frame.sky.x);
}

// Marches the ray from ro along dir over [ta, tb] in `steps` jittered steps,
// adding the light scattered toward the eye to L and dimming T.
void march(vec3 ro, vec3 dir, float ta, float tb, int steps, bool detail, float jitter, vec3 haze, inout vec3 L, inout float T) {
    float ds = (tb - ta) / float(steps);
    vec3 drift = WIND * gTime;
    float mu = dot(dir, MOON_DIR), air = airDensity();
    for (int i = 0; i < steps; ++i) {
        float t = ta + (float(i) + jitter) * ds;
        vec3 rel = dir * t;
        // the cities' cloud stays over them, while the clouds drift through it
        float edge = cityEdge(rel.xz), field = cloudCover(rel.xz, edge);
        if (field <= 0.001) continue;
        vec3 pw = ro + rel;              // world position: the city glow stays put...
        pw.y += planetDrop(rel.xz);      // (its height above the planet's curved ground)
        vec3 p = pw + drift;             // ...while the clouds drift over it
        Column c = column(p.xz, field);
        // the deck thins out towards CLOUD_REACH, measured across the ground,
        // so seen from high above it fades rather than ends on a line
        float d = density(p, c, detail) * (1.0 - smoothstep(0.6 * CLOUD_REACH, CLOUD_REACH, length(rel.xz)));
        if (d <= 0.002) continue;
        float Ts = exp(-d * SIGMA * ds);
        vec3 lit = lightAt(p, c, cityGlow(pw.xz) * cityLight(edge), mu) + signLight(rel);
        // seen through the haze of the air round the camera (the city's, as
        // fogAmount, or the countryside's) between the eye and this step
        vec3 s = mix(lit, haze, cloudFog(rel, t, air));
        L += T * (1.0 - Ts) * s;
        T *= Ts;
        if (T < 0.01) { T = 0.0; return; }
    }
}

// The stretch [ta, tb] of the ray along dir (from the camera) that passes
// over ground some city's cloud can reach; false if none does.
bool cloudSpan(vec3 dir, out float ta, out float tb) {
    const float FRINGE = CLOUD_BORDER + CLOUD_FADE + CLOUD_RAGGED;
    vec2 d = dir.xz;
    float dd = dot(d, d);
    ta = 1e30; tb = -1e30;
    for (int i = 0; i < int(frame.sky.y); ++i) {
        vec2 c = frame.cities[i].xy;
        float R = frame.cities[i].z + FRINGE;
        if (dd < 1e-10) {   // straight up or down: over the camera's spot
            if (dot(c, c) < R * R) { ta = 0.0; tb = 1e30; }
            continue;
        }
        // |d t - c| = R
        float b = dot(d, c), disc = b * b - dd * (dot(c, c) - R * R);
        if (disc < 0.0) continue;
        float s = sqrt(disc);
        ta = min(ta, (b - s) / dd);
        tb = max(tb, (b + s) / dd);
    }
    ta = max(ta, 0.0);
    return tb > ta;
}

void main() {
    ivec2 hp = ivec2(gl_GlobalInvocationID.xy);
    ivec2 hs = imageSize(cloudOut);
    if (any(greaterThanEqual(hp, hs))) return;
    gTime = frame.camPos.w;

    // The nearest scene depth in this pixel's 2x2 block (reverse-Z: largest is nearest).
    ivec2 fs = textureSize(sceneDepth, 0);
    float dz = -1.0;
    ivec2 pick = hp * 2;
    for (int k = 0; k < 4; ++k) {
        ivec2 c = min(hp * 2 + ivec2(k & 1, k >> 1), fs - 1);
        float z = texelFetch(sceneDepth, c, 0).r;
        if (z > dz) { dz = z; pick = c; }
    }
    float fwd = dz > 0.0 ? NEAR_PLANE * FAR_PLANE / (dz * (FAR_PLANE - NEAR_PLANE) + NEAR_PLANE) : 1e9;
    imageStore(cloudDist, hp, vec4(fwd));

    vec2 ndc = (vec2(pick) + 0.5) / vec2(fs) * 2.0 - 1.0;
    vec3 dir = normalize(frame.rayBasis[2].xyz + ndc.x * frame.rayBasis[0].xyz - ndc.y * frame.rayBasis[1].xyz);
    float tScene = fwd / max(dot(dir, frame.camFwd.xyz), 1e-4);
    vec3 ro = frame.camPos.xyz;
    imageStore(mistOut, hp, vec4(mistLight(dir, tScene, frame.weather.x), 1.0));

    // The ray's span inside the cloud layer, up to the scene and CLOUD_REACH,
    // over the cities' cloud: the distant proxies stand into the deck far
    // beyond the chunks' view distance, so it must cover them there too.
    // Within VIEW_DISTANCE every 5 m or so with the eroded detail; beyond it,
    // where the haze has taken most of the deck, every FAR_STEP metres
    // without, and past MID_REACH coarser still while the haze leaves any.
    float lo = SCUD_LO, hi = CLOUD_TOP, t0, t1;
    if (abs(dir.y) < 1e-5) {
        t0 = 0.0;
        t1 = (ro.y > lo && ro.y < hi) ? 1e9 : -1.0;
    } else {
        float ta = (lo - ro.y) / dir.y, tb = (hi - ro.y) / dir.y;
        t0 = max(min(ta, tb), 0.0);
        t1 = max(ta, tb);
    }
    float hz = max(length(dir.xz), 1e-6);
    t1 = min(t1, min(tScene, CLOUD_REACH / max(hz, CLOUD_REACH / 1e6)));
    float sa, sb;
    if (!cloudSpan(dir, sa, sb)) t1 = -1.0;
    t0 = max(t0, sa);
    t1 = min(t1, sb);
    if (t1 <= t0) { imageStore(cloudOut, hp, vec4(0.0, 0.0, 0.0, 1.0)); return; }

    float jitter = ign(vec2(hp));
    vec3 haze = hazeColor(dir);
    float T = 1.0;
    vec3 L = vec3(0.0);
    float tNear = min(t1, frame.camFwd.w);
    if (tNear > t0) {
        int steps = int(clamp((tNear - t0) / 5.0, 16.0, 80.0));
        march(ro, dir, t0, tNear, steps, true, jitter, haze, L, T);
    }
    float tFar = max(t0, tNear), tMid = min(t1, max(tFar, MID_REACH / hz));
    if (tMid > tFar && T > 0.0) {
        int steps = int(clamp((tMid - tFar) / FAR_STEP, 4.0, 64.0));
        march(ro, dir, tFar, tMid, steps, false, jitter, haze, L, T);
    }
    if (t1 > tMid && T > 0.0 && 1.0 - cloudFog(dir * tMid, tMid, airDensity()) > 0.02)
        march(ro, dir, tMid, t1, DISTANT_STEPS, false, jitter, haze, L, T);
    imageStore(cloudOut, hp, vec4(L, T));
}
