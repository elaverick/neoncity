#version 450
#extension GL_GOOGLE_include_directive : require
/* The light scattered more than once (Hillaire 2020, section 5.5), made once:
 * for a point at each height and a sun at each height in the sky, the
 * second-order light reaching it from every direction (lit by a sun of unit
 * illuminance, through isotropic scattering, and the ground's bounce) and the
 * share f_ms of light the air round it scatters back, summed as a geometric
 * series: psi_ms = L2 / (1 - f_ms). The sky (atmo_skyview.comp) multiplies it
 * by the scattering at each step. */
layout(local_size_x = 8, local_size_y = 8) in;
#include "atmo_tables.glsl"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= ATMO_MS_SIZE || p.y >= ATMO_MS_SIZE) return;
    float muSun = uvToUnit((float(p.x) + 0.5) / float(ATMO_MS_SIZE), float(ATMO_MS_SIZE)) * 2.0 - 1.0;
    float h = max(uvToUnit((float(p.y) + 0.5) / float(ATMO_MS_SIZE), float(ATMO_MS_SIZE)) * ATMO_HEIGHT, 0.002);
    float r = AIR_BOTTOM + h;
    vec3 L = vec3(sqrt(max(1.0 - muSun * muSun, 0.0)), muSun, 0.0);   // towards the sun
    vec3 P0 = vec3(0.0, r, 0.0);
    const int DIRS = 64, STEPS = 20;
    const float ISO = 1.0 / (4.0 * AIR_PI);
    vec3 L2 = vec3(0.0), fms = vec3(0.0);
    for (int k = 0; k < DIRS; ++k) {   // a Fibonacci sphere
        float y = 1.0 - (float(k) + 0.5) * 2.0 / float(DIRS), s = sqrt(1.0 - y * y);
        float a = float(k) * 2.39996323;
        vec3 dir = vec3(s * cos(a), y, s * sin(a));
        float tg = airToGround(r, y, h), tmax = tg >= 0.0 ? tg : airToTop(r, y);
        float dt = tmax / float(STEPS);
        vec3 thr = vec3(1.0), Ls = vec3(0.0), Fs = vec3(0.0);
        for (int i = 0; i < STEPS; ++i) {
            vec3 P = P0 + dir * ((float(i) + 0.5) * dt);
            float rs = length(P), hs = rs - AIR_BOTTOM;
            AirAt air = airAt(hs);
            vec3 scat = air.scatR + air.scatM;
            vec3 Ts = exp(-air.ext * dt);
            vec3 S = scat * ISO * airLitBy(transLut, rs, hs, dot(P, L) / rs);
            vec3 inv = (1.0 - Ts) / max(air.ext, vec3(1e-7));
            Ls += thr * S * inv;
            Fs += thr * scat * inv;
            thr *= Ts;
        }
        if (tg >= 0.0) {   // the ground's bounce
            vec3 Pg = P0 + dir * tg;
            float mug = dot(normalize(Pg), L);
            Ls += thr * airTransmittance(transLut, AIR_BOTTOM, mug) * max(mug, 0.0) * (ATMO_GROUND_ALBEDO / AIR_PI);
        }
        L2 += Ls;
        fms += Fs;
    }
    // over the sphere's 4 pi, isotropic scattering's 1 / 4 pi: the means
    L2 /= float(DIRS);
    fms /= float(DIRS);
    imageStore(msOut, p, vec4(L2 / max(1.0 - fms, vec3(1e-3)), 1.0));
}
