#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_ballot : require
#include "common.glsl"
#include "terrain/road_lookup.glsl"
#include "grass/lod.glsl"
#include "grass/surface.glsl"
#define GRASS_INSTANCE_ACCESS writeonly
#include "grass/instance.glsl"
#include "grass/prepare_common.glsl"
#include "grass/patch_light.glsl"
#define CAVE_HOLES_SET 0
#define CAVE_HOLES_BINDING 17
#include "terrain/cave_hole.glsl"
// the moon's shadow at each root (the march through the clipmap's samples, surface.glsl's)
#include "terrain/dir_shadow.glsl"

/* The grass's GPU path (src/render/grass_gpu.c), the land's grass: one
 * workgroup per patch of the GRASS_PATCH_GRID square round the camera's.
 *
 * First, for every patch, the freeway whose lamps light it, for its blades'
 * light (grass/patch_light.glsl, GR7).
 * A: the patch is dropped if it lies beyond GRASS_RADIUS, if every species'
 *    blades would have given way to the ground (grassEnd) at its nearest
 *    point, or it is off the drawn ground; then its 9 x 9 metre points (every
 *    vertex of the levels it can lie in) bound its heights, for the frustum,
 *    and the rules' inputs, so a patch where nothing may grow (the city, rock,
 *    snow, steep) or a species can't is dropped before its roots.
 * B: each candidate root of each species there (grass_rules.h): skipped if
 *    even its tallest is too small on screen for the bucket it could be in,
 *    or if its species' and keeping's draws already lose to the most the
 *    patch's bounds allow; the rest are queued (grass/prepare_common.glsl),
 *    and taken off the queue a workgroup's worth at a time for the dear part:
 *    the ground under it (grass/surface.glsl), the road near it, and the
 *    rules (grass/rules.glsl, grass_keep); none grows in or at the edge of a
 *    cave's mouth (terrain/cave_hole.glsl, the cut kept GRASS_CAVE_CLEAR off). A kept root's level of detail
 *    (grass/lod.glsl) comes from its height's size on screen at its
 *    distance: its bucket, how many of its blades are drawn and how much
 *    wider, its ribbon's morph; its species' end (grassEnd) narrows them all
 *    as the ground takes over. Past the distance the last frame's finish keeps
 *    its bucket to, its blades are counted and dropped.
 * C: the blades of the roots kept: each subgroup reserves room in each bucket
 *    with one atomic, and each root writes its tuft's blades (the bucket's
 *    share of them) there, as far as the room goes.
 * The blades each bucket wanted are counted by distance for finish.comp,
 * which writes the draws (stage D). Nothing is kept from frame to frame but
 * the distance kept to: the roots come from their hashes every frame. */

layout(local_size_x = GRASS_WG) in;
layout(std430, set = 0, binding = 10) writeonly buffer Patches { uint patchState[]; };
// Each patch's freeway (grass/patch_light.glsl): its blades take its lamps' light as the ground beside it does.
layout(std430, set = 0, binding = 16) writeonly buffer PatchLights { uvec4 patchLight[]; };

shared uint sHist[GRASS_BUCKETS * GRASS_BINS];
shared uint sHLo, sHHi, sFound;
shared uint sBase, sSlope, sSnow, sUrban;           // each factor's most over the patch (float bits)
shared uint sShareLo, sShareHi, sWetLo, sWetHi;      // the mud's share and the wet, least and most
shared uint sCand, sEval, sKept, sCut[GRASS_BUCKETS];
shared uint sSpEval[2], sSpBlades[2];                // meadow's and reeds': candidates evaluated, their kept roots' blades

// How far (the field's units, about metres) a root keeps from a cave's mouth's cut.
const float GRASS_CAVE_CLEAR = 0.6;

float reedsWeight(float share, float wet) { return grassSat(float(GRASS_REEDS_MUD) * share + float(GRASS_REEDS_WET) * grassEase(GRASS_REEDS_WET0, GRASS_REEDS_WET1, wet)); }

void main() {
    uint tid = gl_LocalInvocationIndex;
    const float S = float(GRASS_PATCH_M);
    int P = gf.info.y;
    ivec2 wg = ivec2(gl_WorkGroupID.xy);
    ivec2 rp = wg - ivec2(P / 2);                      // patches from the camera's
    ivec2 gpatch = frame.grassPatch.xy + rp;
    uint pidx = uint(wg.y * P + wg.x);
    vec2 corner = vec2(rp) * S - frame.grass.xy;       // camera-relative
    bool allFull = (gf.info.z & GRASS_MODE_ALL_FULL) != 0;
    float fy = gf.view.y;

    // the freeway whose lamps light the patch, from its middle (every patch,
    // so a blade leaning over from a neighbour's root finds its own)
    if (tid == 0u) {
        RoadHit fw;
        bool lit = roadFreewayNear(corner + 0.5 * S, FREEWAY_REACH + 0.7072 * S + 0.5, fw);
        patchLight[pidx] = lit ? grassPatchLightPack(fw) : uvec4(0u);
    }

    // A: range and size on screen
    float dNear = length(clamp(vec2(0.0), corner, corner + S));
    float tallest = max(rootTallest(GRASS_MEADOW), rootTallest(GRASS_REEDS));
    float typical = max(typicalMost(GRASS_MEADOW), typicalMost(GRASS_REEDS));
    if (dNear > gf.view.x || gf.info.x >= TERRAIN_CLIP_LEVELS || (!allFull && !(grassEnd(typical, dNear, fy, gf.view.x) > 0.0))) {
        if (tid == 0u) patchState[pidx] = GRASS_PATCH_OUT;
        return;
    }
    if (tid == 0u) {
        sHLo = 0xFFFFFFFFu; sHHi = 0u; sFound = 0u;
        sBase = sSlope = sSnow = sUrban = 0u;
        sShareLo = sWetLo = floatBitsToUint(1.0); sShareHi = sWetHi = 0u;
        sCand = sEval = sKept = 0u;
        for (int b = 0; b < GRASS_BUCKETS; ++b) sCut[b] = 0u;
        sSpEval[0] = sSpEval[1] = sSpBlades[0] = sSpBlades[1] = 0u;
    }
    for (uint i = tid; i < uint(GRASS_BUCKETS * GRASS_BINS); i += uint(GRASS_WG)) sHist[i] = 0u;
    barrier();

    // A: the patch's heights and the rules' inputs at its metre points
    for (uint i = tid; i < 81u; i += uint(GRASS_WG)) {
        GrassGround g;
        if (!grassSurface(corner + vec2(float(i % 9u), float(i / 9u)), g)) continue;
        atomicOr(sFound, 1u);
        atomicMin(sHLo, fkey(g.h));
        atomicMax(sHHi, fkey(g.h));
        float mud = g.cb.x;
        atomicMax(sBase, floatBitsToUint(min(g.ca.z + float(GRASS_SUIT_MUD) * mud, 1.0)));
        atomicMax(sSlope, floatBitsToUint(grassEase(GRASS_SLOPE_NONE, GRASS_SLOPE_FULL, g.n.y)));
        atomicMax(sSnow, floatBitsToUint(1.0 - grassEase(GRASS_SNOW_FROM, GRASS_SNOW_NONE, g.cb.y)));
        atomicMax(sUrban, floatBitsToUint(1.0 - grassEase(GRASS_URBAN_FROM, GRASS_URBAN_NONE, g.urban)));
        float share = mud / max(g.ca.z + mud, 1e-4);
        atomicMin(sShareLo, floatBitsToUint(share)); atomicMax(sShareHi, floatBitsToUint(share));
        atomicMin(sWetLo, floatBitsToUint(g.cb.z));  atomicMax(sWetHi, floatBitsToUint(g.cb.z));
    }
    barrier();
    if (sFound == 0u) {
        if (tid == 0u) patchState[pidx] = GRASS_PATCH_OUT;
        return;
    }
    float camY = frame.camPos.y;
    float hLo = funkey(sHLo), hHi = funkey(sHHi);
    if (tid == 0u) atomicAdd(counters[GRASS_C_PATCHES_RANGE], 1u);
    // (the planet's bend drops the ground a few mm this near: the margin holds
    // it; a blade is no longer than its height however it leans, bends and
    // blows over, and its width tapers faster than its length rises)
    float side = 0.2 + tallest;
    vec3 mn = vec3(corner.x - side, hLo - camY - 0.2, corner.y - side);
    vec3 mx = vec3(corner.x + S + side, hHi - camY + 1.25 * tallest + 0.2, corner.y + S + side);
    if ((gf.info.z & GRASS_MODE_ALL_IN_VIEW) == 0 && !inView(mn, mx)) {
        if (tid == 0u) patchState[pidx] = GRASS_PATCH_HIDDEN;
        return;
    }
    if (tid == 0u) atomicAdd(counters[GRASS_C_PATCHES_VIEW], 1u);
    float suitMost = uintBitsToFloat(sBase) * uintBitsToFloat(sSlope) * uintBitsToFloat(sSnow) * uintBitsToFloat(sUrban);
    float reedsMost = reedsWeight(uintBitsToFloat(sShareHi), uintBitsToFloat(sWetHi));
    float meadowMost = 1.0 - reedsWeight(uintBitsToFloat(sShareLo), uintBitsToFloat(sWetLo));
    if (!(suitMost > 0.0)) {
        if (tid == 0u) patchState[pidx] = GRASS_PATCH_BARE;
        return;
    }
    if (tid == 0u) atomicAdd(counters[GRASS_C_PATCHES_GRASS], 1u);
    // a road near enough to thin any root here (roadEdgeNear: from the patch's middle)
    bool nearRoad = roadEdgeNear(corner + 0.5 * S) < 0.7072 * S + float(GRASS_ROAD_FULL) + 0.5;
    // the camera's height off the patch's heights: the least it can be from a root
    float dy = max(max(hLo - camY, camY - hHi), 0.0);

    for (int ki = 0; ki < 2; ++ki) {
        int k = ki == 0 ? GRASS_MEADOW : GRASS_REEDS;
        if (!GRASS_PRESENT(k) || !((k == GRASS_MEADOW ? meadowMost : reedsMost) > 0.0)) continue;
        int n = GRASS_GRID(k), total = n * n, rounds = (total + GRASS_WG - 1) / GRASS_WG;
        float hk = rootTallest(k), tk = grassTypical(k, 1.0);
        float wMost = k == GRASS_MEADOW ? meadowMost : reedsMost;
        if (tid == 0u) { atomicAdd(sCand, uint(total)); sQn = 0u; }
        barrier();
        for (int r = 0; r <= rounds; ++r) {
            // B, cheaply: this round's candidates that may be drawn and kept go on the queue
            // (the evaluated count, the area the blades/m2 is over, is of those not too small)
            int idx = r * GRASS_WG + int(tid);
            if (r < rounds && idx < total) {
                ivec2 cell = ivec2(idx % n, idx / n);
                bool sub = ((cell.x | cell.y) & 1) == 0;   // the clump bucket's roots
                GrassCandidate cand = grassCandidate(k, gpatch, cell);
                vec2 rel = corner + cand.p;
                bool maybe = true;
                if (!allFull) {   // the most it could be on screen; its species not yet given way
                    float dLo = max(length(vec3(rel.x, dy, rel.y)), 1e-3);
                    maybe = grassEnd(tk, dLo, fy, gf.view.x) > 0.0 && (sub || hk * fy / dLo >= float(GRASS_LOD_MID_PX));
                }
                if (maybe) {
                    atomicAdd(sEval, 1u);
                    atomicAdd(sSpEval[ki], 1u);
                    if (grassMayKeep(k, cand, wMost, suitMost)) sQ[atomicAdd(sQn, 1u)] = uint(idx);
                }
            }
            barrier();
            uint qn = sQn;
            uint take = qn >= uint(GRASS_WG) || r == rounds ? min(qn, uint(GRASS_WG)) : 0u;
            if (take == 0u) { barrier(); continue; }   // (uniform: every invocation read the same qn)
            int tier = -1;
            uint nb = 0u;
            GrassLod lod;
            float endK = 1.0;
            GrassRoot root;
            GrassGround gg;
            if (tid < take) {
                int qi = int(sQ[qn - take + tid]);
                ivec2 cell = ivec2(qi % n, qi / n);
                bool sub = ((cell.x | cell.y) & 1) == 0;
                GrassCandidate cand = grassCandidate(k, gpatch, cell);
                vec2 rel = corner + cand.p;
                if (grassSurface(rel, gg) && !caveHoleCut(rel, gg.h, GRASS_CAVE_CLEAR)) {
                    GrassSite s;
                    s.grass = gg.ca.z; s.mud = gg.cb.x; s.snow = gg.cb.y; s.wet = gg.cb.z;
                    s.ny = gg.n.y; s.urban = gg.urban; s.maintained = 0.0; s.city = 0;
                    s.road = float(GRASS_ROAD_FAR);
                    if (nearRoad) {
                        RoadHit h;
                        if (roadNear(rel, h)) s.road = roadPaved(h, 0.0) ? -1.0 : abs(h.off) - h.hw;
                    }
                    if (grassKeep(cand, s, root)) {
                        atomicAdd(sSpBlades[ki], uint(root.blades));
                        float dist = length(planetBend(rel, gg.h));
                        if (allFull) lod = grassLodAll(root.blades);
                        else {
                            endK = grassEnd(grassTypical(k, grassSuitability(s)), dist, fy, gf.view.x);
                            lod = grassLod(root.height * fy / max(dist, 1e-3), root.blades, sub);
                            if (!(endK > 0.0)) lod.count = 0;
                        }
                        if (lod.count > 0) {
                            tier = lod.bucket;
                            nb = uint(lod.count);
                            atomicAdd(sKept, 1u);
                            atomicAdd(sHist[tier * GRASS_BINS + min(int(dist / float(GRASS_BIN_M)), GRASS_BINS - 1)], nb);
                            if (dist >= keepTo[tier]) {   // past the distance kept to: counted, not drawn
                                atomicAdd(sCut[tier], nb);
                                nb = 0u;
                                tier = -1;
                            }
                        }
                    }
                }
            }
            // C: room in each bucket, one atomic a subgroup
            uint at = grassReserve(tier, nb);
            if (tier >= 0) {
                uint room = gf.cap[tier];
                // the directional light's shadow at the root (the sun's or the moon's), as the ground there takes it (terrain.frag), in the word
                // beside each of its blades (a city blade's chunk: grass/instance.glsl)
                vec2 rr = corner + root.at.p;
                float moon = 1.0;
                if (cloudCover(rr, cityEdge(rr)) < 0.99) moon = dirShadow(vec3(rr.x, gg.h, rr.y), gg.n, frame.dirLight.xyz, length(rr));
                for (uint bi = 0u; bi < nb && at + bi < room; ++bi) {
                    GrassBlade g = grassBlade(root, int(bi));
                    // narrowed away, or widened for those gone (grass/lod.glsl), and by the species' end
                    float width = min(g.width * grassLodWidth(lod, int(bi)) * endK, float(GRASS_WIDE_MAX) * g.height);
                    vec2 off = g.p - root.at.p;
                    // the ground's plane under the root, to the blade (within a tuft's width)
                    float hb = gg.h - (gg.n.x * off.x + gg.n.z * off.y) / max(gg.n.y, 0.2);
                    GrassInstance o;
                    grassPack(planetBend(corner + g.p, hb), g.height, gg.n, g.facing, g.leanDir, width, g.lean, g.bend, g.phase,
                              g.tint, root.clump.stiffness, k, tier, lod.morph, o);
                    inst[gf.base[tier] + at + bi] = o;
                    instChunk[gf.base[tier] + at + bi] = floatBitsToUint(moon);
                }
            }
            barrier();   // every invocation has read its entry and qn
            if (tid == 0u) sQn = qn - take;
            barrier();
        }
    }
    barrier();
    for (uint i = tid; i < uint(GRASS_BUCKETS * GRASS_BINS); i += uint(GRASS_WG))
        if (sHist[i] != 0u) atomicAdd(counters[GRASS_C_HIST + i], sHist[i]);
    if (tid == 0u) {
        atomicAdd(counters[GRASS_C_CANDIDATES], sCand);
        atomicAdd(counters[GRASS_C_EVALUATED], sEval);
        atomicAdd(counters[GRASS_C_KEPT], sKept);
        for (int b = 0; b < GRASS_BUCKETS; ++b) if (sCut[b] != 0u) atomicAdd(counters[GRASS_C_CUT + b], sCut[b]);
        for (int q = 0; q < 2; ++q) {
            int k = q == 0 ? GRASS_MEADOW : GRASS_REEDS;
            if (sSpEval[q] != 0u) atomicAdd(counters[GRASS_C_SP_EVAL + k], sSpEval[q]);
            if (sSpBlades[q] != 0u) atomicAdd(counters[GRASS_C_SP_BLADES + k], sSpBlades[q]);
        }
        patchState[pidx] = sKept > 0u ? GRASS_PATCH_DRAWN : GRASS_PATCH_NONE;
    }
}
