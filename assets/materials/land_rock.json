// Bare rock: the land's cliffs and steep slopes (rock), triplanar where steep.
// One of the land's ground-cover classes (src/terrain/terrain_cover.c), textured near the
// camera and drawn as its colour beyond (shaders/terrain/ground.glsl), mapped in world x and z.
// Rock028 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c.
{
  "maps": {
    "albedo": "../textures/rock_028/albedo.png",
    "normal": "../textures/rock_028/normal.png",
    "orm":    "../textures/rock_028/orm.png"
  },
  "tile": 4.0,                // metres per image: divides 64 chunks (7040 m), where the shaders' world coordinates wrap
  "albedo_mean": [0.087, 0.083, 0.065],   // per channel (pbr_pack)
  "albedo_scale": 1.40,        // to the night's palette: keeps the flat colours the land had before it was textured
  // the colour (linear) its mean is drawn as (0: its own mean times albedo_scale); how strongly the normal map bends the ground (1 as authored)
  "params": [0.000, 0.000, 0.000, 1.0],
  // the height map's median and spread (its 5th to 95th percentile): where the classes meet (shaders/terrain/ground.glsl), and where water stands
  "relief": [0.765, 0.698],
  // in the rain (the land's shaders): how much darker it goes, how readily water stands in its hollows, how its wet film shines (0 .. 1)
  "wet": [0.20, 0.00, 0.80],
  // the snow over it: how soon it lies (1 as the cover's snow weight), and where first (0 its height map's hollows .. 1 its tops)
  "snow": [0.6, 1.0]
}
