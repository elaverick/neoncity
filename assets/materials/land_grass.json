// Moss and short grass with soil showing (grass): the ground grass blades will stand on, not a lawn.
// One of the land's ground-cover classes (src/terrain/terrain_cover.c), textured near the
// camera and drawn as its colour beyond (shaders/terrain/ground.glsl), mapped in world x and z.
// Ground037 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c.
{
  "maps": {
    "albedo": "../textures/ground_037/albedo.png",
    "normal": "../textures/ground_037/normal.png",
    "orm":    "../textures/ground_037/orm.png"
  },
  "tile": 2.2,                // metres per image: divides 64 chunks (7040 m), where the shaders' world coordinates wrap
  "albedo_mean": [0.338, 0.315, 0.118],   // per channel (pbr_pack)
  "albedo_scale": 1.00,        // to the night's palette: keeps the flat colours the land had before it was textured
  // the colour (linear) its mean is drawn as: the park lawns' hue (shaders/city/ground.glsl), so the
  // land's grass meets the city's at its edge; how strongly the normal map bends the ground (1 as authored)
  "params": [0.050, 0.066, 0.034, 1.0],
  // the height map's median and spread (its 5th to 95th percentile): where the classes meet (shaders/terrain/ground.glsl), and where water stands
  "relief": [0.529, 0.173],
  // in the rain (the land's shaders): how much darker it goes, how readily water stands in its hollows, how its wet film shines (0 .. 1)
  "wet": [0.30, 0.25, 0.15],
  // the snow over it: how soon it lies (1 as the cover's snow weight), and where first (0 its height map's hollows .. 1 its tops)
  "snow": [1.4, 0.0]
}
