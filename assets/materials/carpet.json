// Dense loop-pile carpet: a lobby's carpet-tiled back rooms (shadeInterior) and the rooms seen
// through windows (interiorColor), in their own colours (pbrGrain, pbrTint).
// Carpet012 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c.
{
  "maps": {
    "albedo": "../textures/carpet_012/albedo.png",
    "normal": "../textures/carpet_012/normal.png",
    "orm":    "../textures/carpet_012/orm.png"
  },
  "tile": 1.0,                 // metres per image
  "albedo_mean": [0.047, 0.057, 0.079],   // per channel (pbr_pack): the tint divides by it
  // how much of the albedo's variation shows (1 all); how strongly the normal map bends the surface (1 as authored)
  "params": [1.0, 1.0]
}
