{
  "maps": {
    "albedo": "../textures/granite_003a/albedo.png",
    "normal": "../textures/granite_003a/normal.png",
    "orm":    "../textures/granite_003a/orm.png"
  },
  "tile": 1.0,                 // metres per image
  "albedo_mean": [0.383, 0.362, 0.364],   // per channel (pbr_pack): the tint divides by it
