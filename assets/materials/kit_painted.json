// Cream enamel paint chipped to rust: an extractor, posts, stool bases (PMAT_PAINTED); under red, a gas
// bottle's, a valve wheel's and a needle's paint (PMAT_RED).
// PaintedMetal010 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c; its metalness in orm's alpha.
{
  "maps": {
    "albedo": "../textures/painted_metal_010/albedo.png",
    "normal": "../textures/painted_metal_010/normal.png",
    "orm":    "../textures/painted_metal_010/orm.png"
  },
  "tile": 0.5,                 // metres per image: chips a few cm across on a stool's post
  "albedo_mean": [0.699, 0.706, 0.673],   // per channel (pbr_pack)
  // shadeKit (shaders/city/kit.glsl): how much of the albedo's variation shows (1 all); how strongly the normal
  // map bends the surface (1 as authored); relief depth in metres (0: none); 1 the photograph's own colour, 0 its
  // grain under the kit's colour for the material
  "params": [1.0, 1.0, 0.0, 1.0]
}
