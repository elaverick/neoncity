// Black rubber's fine grain: stool seats, cable sheaths, grips (PMAT_RUBBER); black plastic knobs and switch
// bodies (PMAT_PLASTIC).
// Rubber004 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c.
{
  "maps": {
    "albedo": "../textures/rubber_004/albedo.png",
    "normal": "../textures/rubber_004/normal.png",
    "orm":    "../textures/rubber_004/orm.png"
  },
  "tile": 0.4,                 // metres per image
  "albedo_mean": [0.024, 0.025, 0.032],   // per channel (pbr_pack)
  // shadeKit (shaders/city/kit.glsl): how much of the albedo's variation shows (1 all); how strongly the normal
  // map bends the surface (1 as authored); relief depth in metres (0: none); 1 the photograph's own colour, 0 its
  // grain under the kit's colour for the material
  "params": [1.0, 1.0, 0.0, 0.0]
}
