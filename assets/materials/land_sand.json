// Fine sand: beaches, river banks and the shallows (sand).
// One of the land's ground-cover classes (src/terrain/terrain_cover.c), textured near the
// camera and drawn as its colour beyond (shaders/terrain/ground.glsl), mapped in world x and z.
// Ground054 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c.
{
  "maps": {
    "albedo": "../textures/ground_054/albedo.png",
    "normal": "../textures/ground_054/normal.png",
    "orm":    "../textures/ground_054/orm.png"
  },
  "tile": 3.52,               // metres per image: divides 64 chunks (7040 m), where the shaders' world coordinates wrap
  "albedo_mean": [0.335, 0.261, 0.158],   // per channel (pbr_pack)
  "albedo_scale": 0.65,        // to the night's palette: keeps the flat colours the land had before it was textured
  // the colour (linear) its mean is drawn as (0: its own mean times albedo_scale); how strongly the normal map bends the ground (1 as authored)
  "params": [0.000, 0.000, 0.000, 1.0],
  // the height map's median and spread (its 5th to 95th percentile): where the classes meet (shaders/terrain/ground.glsl), and where water stands
  "relief": [0.655, 0.341]
}
