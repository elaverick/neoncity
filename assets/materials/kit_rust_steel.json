// Grey steel sheet rusting in blooms, bare metal between: a vendor's side walls, back lining and framing
// (PMAT_RUST_STEEL).
// Metal025 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c; its metalness in orm's alpha.
{
  "maps": {
    "albedo": "../textures/metal_025/albedo.png",
    "normal": "../textures/metal_025/normal.png",
    "orm":    "../textures/metal_025/orm.png"
  },
  "tile": 1.5,                 // metres per image
  "albedo_mean": [0.090, 0.054, 0.042],   // per channel (pbr_pack)
  // shadeKit (shaders/city/kit.glsl): how much of the albedo's variation shows (1 all); how strongly the normal
  // map bends the surface (1 as authored); relief depth in metres (0: none); 1 the photograph's own colour, 0 its
  // grain under the kit's colour for the material
  "params": [1.0, 1.0, 0.0, 1.0]
}
