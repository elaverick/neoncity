// Copper-brown sheet rusted right through, streaked down its fall: a noodle bar's barrel hood (PMAT_RUST),
// its panels, rolled lip and ends.
// Rust006 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c; its metalness in orm's alpha.
{
  "maps": {
    "albedo": "../textures/rust_006/albedo.png",
    "normal": "../textures/rust_006/normal.png",
    "orm":    "../textures/rust_006/orm.png"
  },
  "tile": 1.2,                 // metres per image
  "albedo_mean": [0.124, 0.032, 0.009],   // per channel (pbr_pack)
  // shadeKit (shaders/city/kit.glsl): how much of the albedo's variation shows (1 all); how strongly the normal
  // map bends the surface (1 as authored); relief depth in metres (0: none); 1 the photograph's own colour, 0 its
  // grain under the kit's colour for the material
  "params": [1.0, 1.0, 0.0, 1.0]
}
