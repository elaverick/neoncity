// Zellige, a plain teal-green field: Middle Eastern villa and courtyard dados (HWT_ZELLIGE_B)
// The user's art (assets_src/tiles/zellige_b.png), its grid laid again by tools/tile_pack.py: 6 x 6 tiles of 10 cm.
// Drawn by houseTile (shaders/city/house.glsl); the six sets' ids run in HWT_* order (house_surf.h).
{
  "maps": {
    "albedo": "../textures/house_tile/zellige_b/albedo.png",
    "normal": "../textures/house_tile/zellige_b/normal.png",
    "orm":    "../textures/house_tile/zellige_b/orm.png"
  },
  "tile": 0.60,                 // metres per image: 6 tiles
  "albedo_mean": [0.032, 0.151, 0.094],   // per channel (tile_pack): the tint divides by it
  // the albedo's variation shown (1 all); the normal map's strength (1 as made); the art's clean glaze to the city's palette
  "params": [1.0, 1.0, 0.82],
  // metres from the faces' tops down into the joints: parallax occlusion mapped (pbrGrainRelief)
  "depth": 0.004
}
