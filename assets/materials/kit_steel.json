{
  "maps": {
    "albedo": "../textures/metal_056a/albedo.png",
    "normal": "../textures/metal_056a/normal.png",
    "orm":    "../textures/metal_056a/orm.png"
  },
  "tile": 0.6,                 // metres per image
  "albedo_mean": [0.508, 0.485, 0.462],   // per channel (pbr_pack)
