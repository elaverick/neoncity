{
  "maps": {
    "albedo": "../textures/bricks_085/albedo.png",
    "normal": "../textures/bricks_085/normal.png",
    "orm":    "../textures/bricks_085/orm.png"
  },
  "tile": [2.4, 1.2],          // metres per image (a 2:1 image of 24 cm bricks)
