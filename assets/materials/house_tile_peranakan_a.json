// Peranakan majolica, rose and green: South-East Asian shophouse dados (HWT_PERANAKAN_A)
// The user's art (assets_src/tiles/peranakan_a.png), its grid laid again by tools/tile_pack.py: 4 x 4 tiles of 15 cm.
// Drawn by houseTile (shaders/city/house.glsl); the six sets' ids run in HWT_* order (house_surf.h).
{
  "maps": {
    "albedo": "../textures/house_tile/peranakan_a/albedo.png",
    "normal": "../textures/house_tile/peranakan_a/normal.png",
    "orm":    "../textures/house_tile/peranakan_a/orm.png"
  },
  "tile": 0.60,                 // metres per image: 4 tiles
  "albedo_mean": [0.480, 0.401, 0.269],   // per channel (tile_pack): the tint divides by it
  // the albedo's variation shown (1 all); the normal map's strength (1 as made); the art's clean glaze to the city's palette
  "params": [1.0, 1.0, 0.82],
  // metres from the faces' tops down into the joints: parallax occlusion mapped (pbrGrainRelief)
  "depth": 0.0035
}
