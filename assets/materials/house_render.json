// Painted render, stained and blotched by the rain: the houses' render and stucco (shadeHouse),
// under the house's paint (pbrGrain).
// Plaster007 (ambientCG, CC0), packed at 1024 by tools/pbr_pack.c.
{
  "maps": {
    "albedo": "../textures/plaster_007/albedo.png",
    "normal": "../textures/plaster_007/normal.png",
    "orm":    "../textures/plaster_007/orm.png"
  },
  "tile": 2.5,                 // metres per image
  "albedo_mean": [0.524, 0.517, 0.476],   // per channel (pbr_pack): the tint divides by it
  // how much of the albedo's variation shows (1 all); how strongly the normal map bends the surface (1 as authored)
  "params": [0.8, 1.0]
}
